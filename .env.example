GEMINI_API_KEY=your_gemini_api_key_here
VECTOR_DB_URL=http://localhost:8000
EMBEDDING_MODEL_NAME=gemini-embedding-001
EMBEDDING_DIMENSION=768
EMBEDDING_BATCH_SIZE=100
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
CHROMA_COLLECTION_NAME=documents
DEFAULT_TOP_K=5
MAX_TOP_K=50
GENERATION_MODEL_NAME=gemini-3.5-flash
GENERATION_TEMPERATURE=0.2
USE_RERANKER=true
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANK_CANDIDATE_K=25
RERANKER_MAX_LENGTH=512
ENABLE_CONTEXT_CACHING=false
STATIC_CONTEXT_PATH=
CACHE_TTL_SECONDS=3600
REDIS_URL=redis://localhost:6379/0
ENABLE_QUERY_CACHE=true
QUERY_CACHE_TTL_SECONDS=3600
ENABLE_SEMANTIC_CACHE=false
SEMANTIC_CACHE_THRESHOLD=0.92
SEMANTIC_CACHE_MAX_ENTRIES=200
ENABLE_INPUT_GUARD=true
MIN_QUERY_LENGTH=2
MAX_QUERY_LENGTH=2000
ENFORCE_LATIN_SCRIPT=true
MIN_LATIN_RATIO=0.70
ENABLE_LLM_INPUT_GUARD=false
BLOCKED_TOPICS=
ENABLE_OUTPUT_GUARD=true
MASK_PII_IN_SOURCES=true
MIN_ANSWER_LENGTH=3
